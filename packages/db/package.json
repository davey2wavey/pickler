{
  "name": "@pickler/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pickler/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "supabase": "2.122.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
